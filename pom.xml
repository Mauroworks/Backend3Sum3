<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.duoc.batch</groupId>
	<artifactId>procesadorf1</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>procesadorf1 (BFF Banco XYZ)</name>
	<description>Proyecto BFF (Backend for Frontend) Banco XYZ - SUMATIVA 2. Agregador de modulos: bff-common, bff-web, bff-mobile y bff-atm.</description>

	<modules>
		<module>bff-common</module>
		<module>bff-web</module>
		<module>bff-mobile</module>
		<module>bff-atm</module>
		<module>saga-contracts</module>
		<module>config-server</module>
		<module>eureka-server</module>
		<module>auth-server</module>
		<module>csv-result-api</module>
		<module>account-service</module>
		<module>reporting-service</module>
	</modules>

		<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2025.1.3</spring-cloud.version>
		<spring-cloud-starter-resilience4j.version>3.3.0</spring-cloud-starter-resilience4j.version>
		<spring-authorization-server.version>1.4.0</spring-authorization-server.version>
		<!-- resilience4j-spring-boot4 es la variante compatible con Spring Boot 4 /
		     Framework 7; la spring-boot3 falla con "Configuration with name 'default'
		     does not exist" al crear el CircuitBreakerRegistry. -->
		<resilience4j.version>2.4.0</resilience4j.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-bom</artifactId>
				<version>${resilience4j.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Spring Boot 4 / Framework 7 ya no arrastran spring-jcl, pero SpringApplication
		     sigue usando la API de commons-logging. Sin este puente, los servicios
		     fallan al arrancar con NoClassDefFoundError: org/apache/commons/logging/LogFactory. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>jcl-over-slf4j</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>